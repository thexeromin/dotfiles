{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    {
        "type": "os",
        "key": "OS",
        "format": "{2} {9}"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
        "type": "display",
        "key": "Resolution",
        "format": "{1}x{2}"
    },
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "break",
    "colors"
  ]
}
